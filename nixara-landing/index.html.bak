<script>
gsap.registerPlugin(ScrollTrigger);

// ══════════════════════════════════════
// SCRAMBLE — "terminal computing" stats
// ══════════════════════════════════════
(function(){
  const NUMS = '0123456789';
  const MIX  = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';

  function scramble(el, final, delay) {
    setTimeout(() => {
      el.classList.add('sc-active');
      let frame = 0;
      const FRAMES = 24;
      const id = setInterval(() => {
        frame++;
        const locked = Math.floor((frame / FRAMES) * final.length);
        el.textContent = final.split('').map((ch, i) => {
          if (i < locked)       return ch;
          if (ch === ' ')       return ' '; // non-breaking space holds width
          const pool = /\d/.test(ch) ? NUMS : MIX;
          return pool[Math.floor(Math.random() * pool.length)];
        }).join('');
        if (frame >= FRAMES) {
          clearInterval(id);
          el.textContent = final;
          el.classList.remove('sc-active');
          el.classList.add('sc-done');
        }
      }, 38);
    }, delay);
  }

  function typeHeader(text, onDone) {
    const el = document.getElementById('stats-label');
    if (!el) return;
    let i = 0;
    el.textContent = '';
    const id = setInterval(() => {
      el.textContent = text.slice(0, ++i);
      if (i >= text.length) { clearInterval(id); if (onDone) onDone(); }
    }, 55);
  }

  window.addEventListener('load', () => {
    // slight delay so hero entrance animation finishes first
    setTimeout(() => {
      typeHeader('running analysis...', () => {
        // fire each stat in sequence
        const els = document.querySelectorAll('[data-scramble]');
        els.forEach((el, i) => scramble(el, el.dataset.scramble, i * 280));

        // after all done, switch header text
        const totalDelay = els.length * 280 + 900;
        setTimeout(() => {
          const lbl = document.getElementById('stats-label');
          if (!lbl) return;
          lbl.style.transition = 'opacity .25s';
          lbl.style.opacity = '0';
          setTimeout(() => {
            lbl.textContent = 'analysis complete.';
            lbl.style.opacity = '1';
          }, 260);
        }, totalDelay);
      });
    }, 900);
  });
})();

// ── Hero entrance sequence
const heroTl = gsap.timeline({ delay: 0.2 });
document.querySelectorAll('#hero .g-fade').forEach((el, i) => {
  heroTl.to(el, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, i * 0.12);
});
const heroRight = document.querySelector('#hero .g-right');
if(heroRight) heroTl.to(heroRight, { opacity: 1, x: 0, duration: 0.9, ease: 'power3.out' }, 0.3);

// ── Scroll-triggered reveals
document.querySelectorAll('.g-fade:not(#hero .g-fade)').forEach(el => {
  ScrollTrigger.create({
    trigger: el, start: 'top 88%',
    onEnter: () => gsap.to(el, { opacity: 1, y: 0, duration: 0.75, ease: 'power3.out' })
  });
});
document.querySelectorAll('.g-left:not(#hero .g-left), .g-right:not(#hero .g-right)').forEach(el => {
  const x = el.classList.contains('g-left') ? -45 : 45;
  ScrollTrigger.create({
    trigger: el, start: 'top 85%',
    onEnter: () => gsap.to(el, { opacity: 1, x: 0, duration: 0.85, ease: 'power3.out' })
  });
});
document.querySelectorAll('.g-scale').forEach(el => {
  ScrollTrigger.create({
    trigger: el, start: 'top 85%',
    onEnter: () => gsap.to(el, { opacity: 1, scale: 1, duration: 0.8, ease: 'power3.out' })
  });
});

// ── Role cards stagger
ScrollTrigger.create({
  trigger: '.role-split', start: 'top 80%',
  onEnter: () => {
    gsap.to(['#rc1','#rc2','#rc3'], { opacity: 1, x: 0, stagger: 0.18, duration: 0.7, ease: 'power3.out' });
  }
});
['#rc1','#rc2','#rc3'].forEach(id => {
  const el = document.querySelector(id);
  if(el){ el.style.opacity = 0; el.style.transform = 'translateX(40px)'; }
});

// ── Decision flow stagger
ScrollTrigger.create({
  trigger: '#df', start: 'top 80%',
  onEnter: () => {
    document.querySelectorAll('.df-row').forEach(r => r.classList.add('ani'));
  }
});

// ── Outcome bars animate on scroll
ScrollTrigger.create({
  trigger: '#ov', start: 'top 80%',
  onEnter: () => {
    document.querySelectorAll('.ovm-bar').forEach(bar => {
      const w = bar.getAttribute('data-w') || 80;
      setTimeout(() => { bar.style.width = w + '%'; }, 200);
    });
  }
});
</script>

</body>
</html>
