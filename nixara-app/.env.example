# ── Nixara environment ───────────────────────────────────────────────────────
# Copy to .env.local for local dev, and set the same names in Vercel for prod.

# OpenAI key used for the FREE tier. This is the operator's own key and it is
# what the H3 spend controls exist to protect. Users who paste their own key
# never touch it.
OPENAI_API_KEY=

# Optional. A caller who pastes this exact value into the API-key field is
# treated as admin and uses OPENAI_API_KEY with no free-tier gating. Leave
# unset if you do not need it. Compared in constant time (lib/openai-key.ts).
NIXARA_ADMIN_TOKEN=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public: safe in the browser, security comes from RLS not from secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED for the free tier (H3). Server-only, bypasses RLS - never expose it
# to the browser and never prefix it with NEXT_PUBLIC_. The quota counters are
# reachable only with this key, so that a browser cannot burn the global bucket
# and deny service to everyone else.
#
# If this is unset the free tier is refused outright (fail closed) and users are
# asked for their own key. That is deliberate: an unbounded server key is worse
# than a disabled free tier.
#
# Run section 13 of ../nixara_supabase_setup.sql before setting this.
SUPABASE_SERVICE_ROLE_KEY=

# ── Free-tier limits (H3) — all optional, defaults shown ─────────────────────
# Free generate-sessions per IP per window. One session = one click = 3 reports.
NIXARA_FREE_SESSIONS_PER_IP=3
# Window for the per-IP allowance, in seconds. Default 24h.
NIXARA_FREE_IP_WINDOW_SECONDS=86400
# Hard ceiling on free generate-sessions per day across ALL callers. This is the
# number that bounds the worst-case daily OpenAI bill. At 3 calls per session
# and roughly 3k tokens per call, 300 sessions is on the order of a few dollars
# a day - tune it to whatever you are willing to lose in a bad 24 hours.
NIXARA_DAILY_FREE_SESSION_CAP=300
# Short per-IP burst guard on the generate route.
NIXARA_BURST_PER_IP=12
NIXARA_BURST_WINDOW_SECONDS=60
